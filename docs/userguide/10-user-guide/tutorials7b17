	<entry>
		<title>Hello World Examples</title>
		<link rel="alternate" type="text/html" href="http://127.0.0.1/pyactive/docs/userguide/10-user-guide/tutorials/9-hello-world-examples"/>
		<published>2013-11-13T21:41:46+00:00</published>
		<updated>2013-11-13T21:41:46+00:00</updated>
		<id>http://127.0.0.1/pyactive/docs/userguide/10-user-guide/tutorials/9-hello-world-examples</id>
		<author>
			<name>Edgar Zamora-Gómez</name>
